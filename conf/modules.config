process {

    // REFERENCE_UTILITIES
    withName: 'INDEX_UNFILTERED_GRAPH' {
        ext.args = params.noNestedDistance ? "--no-nested-distance" : null
    }
    withName: 'INDEX_FILTERED_GRAPH' {
        ext.args = params.noNestedDistance ? "--no-nested-distance" : null
    }

    // PREPROCESS_READS
    withName: 'FASTP' {
        ext.args = !params.discardUnmerged ? "--include_unmerged" : null
        ext.args2 = params.fastpDedup ? "--dedup" : null
    }

    // ALIGN_READS
    withName: 'GIRAFFE' {
        ext.args = params.gamDiscardUnmapped ? "--only-mapped" : null
        ext.args2 = params.gamFilterMapQ ? "--min-mapq ${params.minimumMapQFilter}" : null
        ext.args3 = params.gamDefrayEnds ? "--defray-ends ${params.defrayEndsLength}" : null
    }
    withName: 'BWA_ALN_SAMSE' {
        ext.args = "-l 16500 -n 0.01 -o 2"
    }

    // MERGE_BAMS


    // DEDUPLICATE_BAM
    withName: 'DEDUPLICATE' {
        ext.args = params.dedupConsiderBothEnds ? "--FLOW_MODE --FLOW_USE_END_IN_UNPAIRED_READS" : null
    }

    // PROFILE_PMD


    // GENOTYPE


    // VARIANT_CALL

}
