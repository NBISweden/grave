/* 
----------------------------------------------------------------------------------------
Default parameter configuration
----------------------------------------------------------------------------------------
*/

// Input params

	params.samplesheet = "samplesheet.csv"
	params.referenceMode = "haplo"

// Process params

	// FASTP
		params.dup_calc_accuracy = "3"
		params.read_discard_length = "30"

	// PANMAP

		// Minimum count each k-mer in a sample readset must reach in order to be retained by kmc (the kmers are then used to sample relevant haplotypes from the graph prior to mapping with giraffe)
		// Default of 2 should work in most normal libraries, but for extremely low coverage libraries/heavily subsampled libraries a near total loss of kmers can occur unless set to 1
		params.kmerMinimumOccurences = "1" // FIXME: set to 2 after testing/when scaling up
				// TODO: Test 2 with normal libraries (assess percentage loss of kmers due to the minimum kmer occurences threshold)

