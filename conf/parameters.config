// Input params

	params.samplesheet = "samplesheet.csv"
	params.referenceMode = "haplo"

// Process specific params

	// FASTP
		params.dup_calc_accuracy = "3"
		params.read_discard_length = "30"

	// PANMAP

		// Minimum k-mer count for indexing by kmc. Should be 2 except when using very low cov./test data, for which 1 may be needed
			params.kmerMinimumOccurences = "2"
