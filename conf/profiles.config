/*
----------------------------------------------------------------------------------------
Profiles with individual process selector configurations
----------------------------------------------------------------------------------------
*/

profiles {

	standard {

		process.executor = 'local'

		process {

			withLabel: process_single {
				cpus = 1
				memory = 800.MB
			}

			withLabel: process_high {
				cpus = 16
				memory = 15.GB
			}

		}

	}

	dardel {

		process.executor = 'local'

		process {
			// TODO: TEST this, N.B. might be incompatible with verify subworkflow - imnplement as a try command b4 error?
			// beforeScript = 'module load PDC apptainer'

			withLabel: process_single {
				cpus = 2
				memory = 1600.MB
			}

			withLabel: process_high {
				cpus = 256
				memory = 256.GB

			}

		}

	}

}

// process_low, process_medium, process_high, process_long, process_high_memory
