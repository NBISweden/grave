/*
----------------------------------------------------------------------------------------
Profiles with individual process selector configurations
----------------------------------------------------------------------------------------
*/

profiles {

	standard {

		process.executor = 'local'

		process {

			withLabel: process_single {
				cpus = 1
				memory = 800.MB
			}

			withLabel: process_low {
				cpus = 2
				memory = 1600.MB
			}

			withLabel: process_medium {
				cpus = 4
				memory = 3800.MB
			}

			withLabel: process_high {
				cpus = 16
				memory = 15.GB
			}

		}

	}

	dardel {

		process.executor = 'local'

		process {
			// TODO: TEST this on Dardel, N.B. probably incompatible with verify subworkflow - implement it as a try command b4 error out?
			// beforeScript = 'module load PDC apptainer'. Could implement as a conditional in main.nf based on profile used. 

			withLabel: process_single {
				cpus = 2
				memory = 1600.MB
			}

			withLabel: process_low {
				cpus = 8
				memory = 7000.MB
			}

			withLabel: process_medium {
				cpus = 32
				memory = 28.GB
			}

			withLabel: process_high {
				cpus = 256
				memory = 220.GB

			}

		}

	}

}

// process_medium, process_long, process_high_memory
