process {

    // REFERENCE_UTILITIES

        withName: 'COMPUTE_SNARLS' {
            memory  = 120.GB
        }
        // Indexing of the sheep genome took 30 seconds. Request short time to limit time in queue.
        withName: 'GALN_INDEX' {
            time    = 1.h
        }

    // PREPROCESS_READS

    // ALIGN_READS

        withName: 'GPU_PREPROCESS' {
            cpus   = 16
        }
        withName: 'GPU_GIRAFFE' {
            stageInMode     = params.align_stage_in_mode
            accelerator     = 1
            cpus            = 16
            memory          = 120.GB
            time            = 4.h
        }
        withName: 'GIRAFFE' {
            stageInMode = params.align_stage_in_mode
            cpus        = 64
            memory      = 120.GB
            time        = 24.h
        }
        withName: 'BWA_ALN_SAMSE' {
            stageInMode = params.align_stage_in_mode
            time        = 36.h
        }
        withName: 'BWAMEM3_MEM' {
            stageInMode = params.align_stage_in_mode
        }

    // MERGE_BAMS

    // DEDUPLICATE_BAM

    // PROFILE_PMD

        withName: 'DAMAGE_PROFILER' {
            memory = 64.GB
            time   = 12.h
        }

    // GENOTYPE

        withName: 'GENOTYPE_READS' {
            memory = 144.GB
            time   = 12.h
        }

    // VARIANT_CALL

        withName: 'FREEBAYES_PARALLEL' {
            cpus   = 4
            memory = 144.GB
        }
        withName: 'GRAPH_DEEPVARIANT' {
            memory = 128.GB
        }

}
