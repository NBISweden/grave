process {

    // REFERENCE_UTILITIES

        withName: 'COMPUTE_SNARLS' {
            memory  = 120.GB
        }

    // PREPROCESS_READS

    // ALIGN_READS

        withName: 'GPU_PREPROCESS' {
            cpus   = 16
        }
        withName: 'GPU_GIRAFFE' {
            accelerator     = 1   // Cloud only
            clusterOptions  = {
                [
                    "-A ${params.project}",
                    params.clusterOptions ?: "",
                    "-p ${params.gpu_partition ?: 'gpu'}",
                    "--gres=gpu:${params.gpu_resources ?: '1'}", // TODO May need to switch --gres=gpu: directly to --gpus
                ].minus("").join(" ")
            }
            containerOptions = {
                workflow.containerEngine in ['singularity', 'apptainer']
                    ? "--${params.apptainer_gpu_flag}"
                    : '--gpus all'
                }
        }
        withName: 'GIRAFFE' {
            cpus   = 64
            memory = 120.GB
            time   = 24.h
        }
        withName: 'BWA_ALN_SAMSE' {
            time   = 36.h
        }

    // MERGE_BAMS

    // DEDUPLICATE_BAM

    // PROFILE_PMD

        withName: 'DAMAGE_PROFILER' {
            memory = 64.GB
            time   = 12.h
        }

    // GENOTYPE

        withName: 'GENOTYPE_READS' {
            memory = 144.GB
            time   = 12.h
        }

    // VARIANT_CALL

        withName: 'FREEBAYES_PARALLEL' {
            cpus   = 4
            memory = 144.GB
        }
        withName: 'GRAPH_DEEPVARIANT' {
            memory = 128.GB
        }

}
