Bootstrap: docker
From: debian:12.5-slim

%environment
	export PATH=/root/.pixi/bin:$PATH
	. /root/cactus-bin-v2.9.0/venv-cactus-v2.9.0/bin/activate

%post
	apt-get update && \
	apt-get install -y curl wget pip  && \
	curl -fsSL https://pixi.sh/install.sh | bash && \
	export PATH=/root/.pixi/bin:$PATH && \
	pixi global install python=3.11 virtualenv git && \
	cd /root && \
	wget -O- https://github.com/ComparativeGenomicsToolkit/cactus/releases/download/v2.9.0/cactus-bin-v2.9.0.tar.gz | tar -xz && \
	cd cactus-bin-v2.9.0 && \
	virtualenv -p python3 venv-cactus-v2.9.0 && \
	printf "export PATH=$(pwd)/bin:\$PATH\nexport PYTHONPATH=$(pwd)/lib:\$PYTHONPATH\n" >> venv-cactus-v2.9.0/bin/activate && \
	. venv-cactus-v2.9.0/bin/activate && \
	git config --global --add safe.directory /root/cactus-bin-v2.9.0 && \
	python3 -m pip install -U setuptools pip wheel && \
	python3 -m pip install -U . && \
	python3 -m pip install -U -r ./toil-requirement.txt
