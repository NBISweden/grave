{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nbisweden/grave/main/nextflow_schema.json",
  "title": "nbisweden/grave pipeline parameters",
  "description": "A workflow for mapping and variant calling aDNA against pangenome graphs",
  "type": "object",
  "properties": {
    "outputDir": {
      "type": "string",
      "default": "results"
    },
    "noNestedDistance": {
      "type": "boolean"
    },
    "aDNAkmerHaplSubSam": {
      "type": "integer",
      "default": 21
    },
    "aDNAwindowHaplSubSam": {
      "type": "integer",
      "default": 11
    },
    "modernKmerHaplSubSam": {
      "type": "integer",
      "default": 29
    },
    "modernWindowHaplSubSam": {
      "type": "integer",
      "default": 11
    },
    "aDNAkmerMinimizer": {
      "type": "integer",
      "default": 21
    },
    "aDNAwindowMinimizer": {
      "type": "integer",
      "default": 11
    },
    "modernKmerMinimizer": {
      "type": "integer",
      "default": 29
    },
    "modernWindowMinimizer": {
      "type": "integer",
      "default": 11
    },
    "discardUnmerged": {
      "type": "boolean"
    },
    "fastpDedup": {
      "type": "boolean"
    },
    "dupCalcAccuracy": {
      "type": "integer",
      "default": 1
    },
    "readDiscardLength": {
      "type": "integer",
      "default": 30
    },
    "gamDefrayEnds": {
      "type": "boolean"
    },
    "defrayEndsLength": {
      "type": "integer",
      "default": 999
    },
    "gamDiscardUnmapped": {
      "type": "boolean"
    },
    "gamFilterMapQ": {
      "type": "boolean",
      "default": true
    },
    "minimumMapQFilter": {
      "type": "integer",
      "default": 30
    },
    "kffKmerMinimum": {
      "type": "integer",
      "default": 2
    },
    "minimumScorePrimaryAlign": {
      "type": "number",
      "default": 0.8
    },
    "keepRawGam": {
      "type": "boolean"
    },
    "duplicateTaggingPolicy": {
      "type": "string",
      "default": "DontTag",
      "enum": ["DontTag", "OpticalOnly", "All"]
    },
    "dedupConsiderBothEnds": {
      "type": "boolean",
      "default": true
    },
    "removeDuplicates": {
      "type": "boolean",
      "default": true
    },
    "maxNestLevel": {
      "type": "integer",
      "default": 0
    },
    "maxRefLength": {
      "type": "integer",
      "default": 100000
    },
    "samplePloidy": {
      "type": "integer",
      "default": 2
    },
    "minimumAlleleSupport": {
      "type": "integer",
      "default": 1
    },
    "keepRawVcf": {
      "type": "boolean"
    },
    "minimumSiteSupport": {
      "type": "integer",
      "default": 4
    },
    "baselineErrorSmallVariants": {
      "type": "number",
      "default": 0.005
    },
    "baselineErrorLargeVariants": {
      "type": "number",
      "default": 0.01
    },
    "maxComplexGap": {
      "type": "integer",
      "default": 3
    },
    "minFraction": {
      "type": "number",
      "default": 0.05
    },
    "deepVariantModelType": {
      "type": "string",
      "default": "WGS",
      "enum": [
        "WGS",
        "WES",
        "PACBIO",
        "ONT_R104",
        "HYBRID_PACBIO_ILLUMINA",
        "MASSEQ"
      ]
    },
    "trace_timestamp": {
      "type": "string",
      "hidden": true
    },
    "tracing": {
      "type": "boolean"
    },
    "validate_params": {
      "type": "boolean",
      "default": true,
      "hidden": true
    },
    "show_hidden": {
      "type": "boolean",
      "hidden": true
    },
    "version": {
      "type": "boolean"
    },
    "monochrome_logs": {
      "type": "boolean",
      "hidden": true
    },
    "outdir": {
      "type": "string",
      "default": "results",
      "hidden": true
    },
    "custom_config_version": {
      "type": "string",
      "default": "master",
      "hidden": true
    },
    "custom_config_base": {
      "type": "string",
      "default": "https://raw.githubusercontent.com/nf-core/configs/master",
      "hidden": true
    },
    "config_profile_name": {
      "type": "string",
      "hidden": true
    },
    "config_profile_description": {
      "type": "string",
      "hidden": true
    },
    "config_profile_contact": {
      "type": "string",
      "hidden": true
    },
    "config_profile_url": {
      "type": "string",
      "hidden": true
    },
    "help_full": {
      "type": "boolean",
      "hidden": true
    }
  },
  "$defs": {
    "mandatory_parameters": {
      "title": "Mandatory parameters",
      "type": "object",
      "description": "",
      "default": "",
      "properties": {
        "steps": {
          "type": "string",
          "description": "Desired workflow steps as a csv string",
          "default": "preprocess,index,align,merge,deduplicate,profile_pmd,graph_genotype,reads_genotype,variant_call"
        }
      },
      "required": ["steps"]
    },
    "core_parameters": {
      "title": "Core parameters",
      "type": "object",
      "description": "Required in most use cases",
      "default": "",
      "properties": {
        "input": {
          "type": "string",
          "format": "file-path",
          "mimetype": "csv",
          "description": "Path to input csv samplesheet"
        },
        "reference": {
          "type": "string",
          "format": "file-path",
          "description": "Path to reference .gbz graph (modes: unfiltered_graph, filtered_graph), or .fasta (mode: linear)"
        },
        "reference_type": {
          "type": "string",
          "enum": ["unfiltered_graph", "filtered_graph", "linear"],
          "description": "The type of reference file provided, changes the run mode accordingly"
        }
      }
    },
    "multi_reference_graphs": {
      "title": "Multi-reference graphs",
      "type": "object",
      "description": "Set when the graph contains multiple reference samples",
      "default": "",
      "properties": {
        "multiple_references": {
          "type": "boolean",
          "description": "Run graph analyses assuming multiple reference assemblies"
        },
        "paths_dir": {
          "type": "string",
          "description": "Path to directory containing '.paths' files"
        }
      }
    },
    "slurm_hpc_specific_parameters": {
      "title": "SLURM/HPC specific parameters",
      "type": "object",
      "description": "",
      "default": "",
      "properties": {
        "project": {
          "type": "string",
          "description": "Used with the SLURM executor: project allocation string for hours logging"
        }
      }
    },
    "optional_processes": {
      "title": "Optional processes",
      "type": "object",
      "description": "",
      "default": "",
      "properties": {
        "freebayes": {
          "type": "boolean",
          "default": true,
          "description": "Turn on (true) or off (false) the Freebayes variant caller"
        },
        "deepvariant": {
          "type": "boolean",
          "description": "Turn on (true) or off (false) the DeepVariant variant caller"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/mandatory_parameters"
    },
    {
      "$ref": "#/$defs/core_parameters"
    },
    {
      "$ref": "#/$defs/multi_reference_graphs"
    },
    {
      "$ref": "#/$defs/slurm_hpc_specific_parameters"
    },
    {
      "$ref": "#/$defs/optional_processes"
    }
  ]
}
