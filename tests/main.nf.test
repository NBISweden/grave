nextflow_pipeline {

    name "grave nf-test"
    script "main.nf"

    test("Unfiltered graph, single reference sample, all steps") {
        tag "01"
        when {
            params {
                steps          = 'preprocess,index,align,merge,deduplicate,profile_pmd,graph_genotype,reads_genotype,variant_call'
                reference_type = 'unfiltered_graph'
                input          = "$projectDir/tests/data/samplesheet.csv"
                reference      = "$projectDir/tests/data/graph/example-unfiltered.gbz"
                deepvariant    = true
                kffKmerMinimum = 2
                outdir         = "$launchDir/results"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0
            assert snapshot(
                workflow.trace.tasks().size(),
                getAllFilesFromDir("$launchDir/results",
                    relative: true,
                    ignore: ["01_pipeline_info/**/**"]
                )
            ).match()
        }
    }

    test("Unfiltered graph, multiple reference samples, all steps") {
        tag "02"
        when {
            params {
                steps               = 'preprocess,index,align,merge,deduplicate,profile_pmd,graph_genotype,reads_genotype,variant_call'
                reference_type      = 'unfiltered_graph'
                input               = "$projectDir/tests/data/samplesheet.csv"
                reference           = "$projectDir/tests/data/graph/additional_graphs/example-multiple-reference-samples.gbz"
                deepvariant         = true
                kffKmerMinimum      = 2
                paths_dir           = "$projectDir/tests/data/paths"
                multiple_references = true
                outdir              = "$launchDir/results"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0
            assert snapshot(
                workflow.trace.tasks().size(),
                getAllFilesFromDir("$launchDir/results",
                    relative: true,
                    ignore: ["01_pipeline_info/**/**"]
                )
            ).match()
        }
    }

    test("Filtered graph, single reference sample, all steps") {
        tag "03"
        when {
            params {
                steps          = 'preprocess,index,align,merge,deduplicate,profile_pmd,graph_genotype,reads_genotype,variant_call'
                reference_type = 'filtered_graph'
                input          = "$projectDir/tests/data/samplesheet.csv"
                reference      = "$projectDir/tests/data/graph/additional_graphs/example-filtered.d2.gbz"
                deepvariant    = true
                kffKmerMinimum = 2
                outdir         = "$launchDir/results"

            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0
            assert snapshot(
                workflow.trace.tasks().size(),
                getAllFilesFromDir("$launchDir/results",
                    relative: true,
                    ignore: ["01_pipeline_info/**/**"]
                )
            ).match()
        }
    }

    test("Linear reference, single reference sample, all steps") {
        tag "04"
        when {
            params {
                steps          = 'preprocess,index,align,merge,deduplicate,profile_pmd,variant_call'
                reference_type = 'linear'
                input          = "$projectDir/tests/data/samplesheet.csv"
                reference      = "$projectDir/tests/data/linear/example.fas"
                deepvariant    = true
                outdir         = "$launchDir/results"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().size() > 0
            assert snapshot(
                workflow.trace.tasks().size(),
                getAllFilesFromDir("$launchDir/results",
                    relative: true,
                    ignore: ["01_pipeline_info/**/**"]
                )
            ).match()
        }
    }

}
